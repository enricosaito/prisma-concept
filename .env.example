# Resend — newsletter list and transactional sends.
# Copy to .env.local for development; set the same keys in the Vercel project
# for preview/production (`vercel env add`, or `npm run env:pull` to sync back).
#
# Without RESEND_API_KEY the subscribe form still works end to end — the
# address is logged and nothing is stored, so the UI can be exercised offline.

# https://resend.com/api-keys — needs "sending access" + full access to contacts.
RESEND_API_KEY=

# The list the form adds to. Resend renamed Audiences to Segments; set whichever
# your dashboard shows. If both are set, the segment wins.
# https://resend.com/audiences
RESEND_AUDIENCE_ID=
RESEND_SEGMENT_ID=

# Sender for the welcome email. The domain has to be verified in Resend
# (https://resend.com/domains) or sends are rejected.
RESEND_FROM="Prisma Concept <carta@prismaconcept.com.br>"

# ---------------------------------------------------------------------------
# Keystatic — o editor em /keystatic, no modo GitHub.
#
# O jeito fácil de preencher: rode `npm run dev`, abra
# http://localhost:3000/keystatic e siga o fluxo. O Keystatic cria o GitHub App
# para você e escreve as quatro variáveis abaixo no .env.local sozinho.
#
# Depois, copie as MESMAS quatro para a Vercel (Settings → Environment
# Variables), senão o editor publicado não autentica.
# ---------------------------------------------------------------------------

# Pública: só o nome do App, que aparece na URL de login.
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ⚠️ SEGREDOS. Credenciais do GitHub App — é o que permite commitar no
# repositório em seu nome. Sem prefixo NEXT_PUBLIC_, nunca.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# ⚠️ SEGREDO. Texto aleatório e longo, usado para assinar a sessão do editor.
# Se vazar, alguém pode forjar uma sessão. O fluxo acima gera sozinho; para
# gerar à mão:  openssl rand -hex 32
KEYSTATIC_SECRET=
